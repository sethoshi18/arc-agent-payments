# ─── Circle Developer Console ──────────────────────────────────────────────
# Get from: https://console.circle.com → API Keys
CIRCLE_API_KEY=

# Entity Secret — generated once, used to derive wallet encryption keys
# NEVER commit the real value. Store in a secret manager.
CIRCLE_ENTITY_SECRET=

# ─── Arc Testnet ────────────────────────────────────────────────────────────
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# ─── Wallet Config ──────────────────────────────────────────────────────────
# Your funded Arc testnet wallet private key (for Foundry/Viem direct sends)
# Use Circle Wallets API instead in production — never hardcode keys in prod.
AGENT_PRIVATE_KEY=

# ─── Deployed Contract Addresses (fill after deploying) ─────────────────────
AGENT_IDENTITY_REGISTRY_ADDRESS=
AGENT_JOB_CONTRACT_ADDRESS=

# ─── MCP Server ─────────────────────────────────────────────────────────────
MCP_SERVER_PORT=3000

# ─── OpenAI (optional — for AI-validated job deliverables like arc-escrow) ──
OPENAI_API_KEY=
