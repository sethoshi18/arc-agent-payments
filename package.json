{
  "name": "arc-agent-payments",
  "version": "0.1.0",
  "description": "AI Agentic Commerce & Payments on Arc (Circle) using App Kits and MCP",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch src/agent/index.ts",
    "start": "node dist/agent/index.js",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@circle-fin/app-kit": "^1.0.0",
    "@circle-fin/user-controlled-wallets": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "viem": "^2.0.0",
    "zod": "^3.22.0",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "tsx": "^4.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
